<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alvinn Portofolio</title>
    
    <!-- Font Kekinian: Outfit untuk teks, Space Grotesk untuk judul -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        /* --- 1. VARIABEL WARNA & RESET --- */
        :root {
            --bg-color: #0a0a0a; /* Hitam pekat */
            --surface: #171717;  /* Abu-abu gelap untuk kartu */
            --accent: hsl(196, 100%, 50%);   /* Hijau Neon ala Gen Z */
            --text-main: #ffffff;
            --text-muted: #a3a3a3;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { 
            font-family: 'Outfit', sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            overflow-x: hidden;
        }
        h1, h2, h3, .logo { font-family: 'Space Grotesk', sans-serif; }
        a { text-decoration: none; color: inherit; }
        
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* --- 2. GLASSMORPHISM NAVBAR --- */
        nav { 
            position: fixed; top: 0; width: 100%; z-index: 100;
            background: rgba(10, 10, 10, 0.7);
            backdrop-filter: blur(12px); /* Efek kaca transparan */
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .nav-container {
            display: flex; justify-content: space-between; align-items: center;
            padding: 20px 24px; max-width: 1200px; margin: 0 auto;
        }
        .logo { font-size: 1.8rem; font-weight: 700; color: var(--accent); }
        .nav-links { display: flex; gap: 32px; background: rgba(255,255,255,0.05); padding: 10px 24px; border-radius: 50px; }
        .nav-links a { font-weight: 600; font-size: 0.9rem; transition: color 0.3s; }
        .nav-links a:hover { color: var(--accent); }
        .menu-btn { display: none; background: none; border: none; font-size: 2rem; color: var(--text-main); cursor: pointer; }

        /* --- 3. HERO SECTION (FOTO & HEADLINE) --- */
        .hero { 
            min-height: 100vh; display: flex; align-items: center; 
            padding-top: 80px; position: relative;
        }
        .hero-content {
            display: flex; align-items: center; justify-content: space-between;
            gap: 40px; width: 100%;
        }
        .hero-text { flex: 1; }
        .badge { 
            display: inline-block; padding: 8px 16px; background: rgba(212, 255, 0, 0.1); 
            color: var(--accent); border: 1px solid var(--accent); 
            border-radius: 50px; font-size: 0.85rem; font-weight: 600; margin-bottom: 24px;
        }
        .hero h1 { font-size: clamp(3rem, 5vw, 5rem); line-height: 1.1; margin-bottom: 20px; }
        .hero h1 span { color: var(--accent); }
        .hero p { font-size: 1.2rem; color: var(--text-muted); margin-bottom: 32px; max-width: 500px; }
        
        /* Tombol Kekinian */
        .btn {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 16px 32px; background-color: var(--accent); color: #000;
            font-weight: 700; font-size: 1rem; border-radius: 12px;
            transition: all 0.3s ease; box-shadow: 0 0 20px rgba(212, 255, 0, 0.3);
        }
        .btn:hover { transform: translateY(-3px); box-shadow: 0 0 30px rgba(212, 255, 0, 0.6); }

        /* Foto Profil Melayang */
        .hero-image { flex: 1; display: flex; justify-content: center; position: relative; }
        .profile-img-container {
            width: 350px; height: 350px; border-radius: 30px;
            background: var(--surface); padding: 10px;
            box-shadow: 20px 20px 0px rgba(212, 255, 0, 0.2); /* Brutalism shadow */
            transform: rotate(3deg); transition: transform 0.5s;
        }
        .profile-img-container:hover { transform: rotate(0deg); }
        .profile-img { width: 100%; height: 100%; object-fit: cover; border-radius: 20px; filter: grayscale(20%); }

        /* --- 4. TEKS BERJALAN (MARQUEE) --- */
        .marquee-container {
            background: var(--accent); color: #000; padding: 16px 0;
            overflow: hidden; white-space: nowrap; transform: rotate(-2deg);
            margin: 40px -20px; width: 110vw;
        }
        .marquee-content {
            display: inline-block; font-family: 'Space Grotesk', sans-serif;
            font-size: 1.5rem; font-weight: 700; animation: marquee 15s linear infinite;
        }
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

        /* --- 5. BENTO BOX: ABOUT ME --- */
        .section { padding: 100px 0; }
        .section-title { font-size: 3rem; margin-bottom: 40px; text-align: center; }
        .section-title span { color: var(--accent); }
        
        .bento-grid {
            display: grid; grid-template-columns: 2fr 1fr; gap: 24px;
        }
        .bento-card {
            background: var(--surface); border-radius: 24px; padding: 40px;
            border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s;
        }
        .bento-card:hover { border-color: var(--accent); }
        .bento-card h3 { font-size: 1.8rem; margin-bottom: 16px; }
        .bento-card p { color: var(--text-muted); font-size: 1.1rem; line-height: 1.8; }
        .skill-tags { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
        .tag { background: rgba(255,255,255,0.1); padding: 8px 16px; border-radius: 50px; font-size: 0.9rem; }

        /* --- 6. PROJECTS --- */
        .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; }
        .project-card { 
            background: var(--surface); border-radius: 20px; overflow: hidden;
            border: 1px solid rgba(255,255,255,0.05); transition: transform 0.4s;
        }
        .project-card:hover { transform: translateY(-10px); }
        .project-img { width: 100%; height: 240px; background: #2a2a2a; display: flex; align-items: center; justify-content: center; color: #555; }
        .project-info { padding: 24px; }
        .project-info h3 { font-size: 1.5rem; margin-bottom: 8px; }
        .project-info p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 16px; }
        .project-link { color: var(--accent); font-weight: 600; font-size: 0.9rem; }

        /* --- 7. FOOTER --- */
        footer { background: var(--surface); padding: 80px 0; text-align: center; margin-top: 50px; border-top: 1px solid rgba(255,255,255,0.1); }
        footer h2 { font-size: 4rem; margin-bottom: 24px; }
        .socials { display: flex; justify-content: center; gap: 20px; margin: 40px 0; }
        .socials a {
            width: 50px; height: 50px; background: rgba(255,255,255,0.05); 
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            transition: all 0.3s; border: 1px solid rgba(255,255,255,0.1);
        }
        .socials a:hover { background: var(--accent); color: #000; transform: scale(1.1); }

        /* --- 8. RESPONSIVE MOBILE --- */
        @media (max-width: 900px) {
            .hero-content { flex-direction: column-reverse; text-align: center; margin-top: 40px; }
            .hero-text { display: flex; flex-direction: column; align-items: center; }
            .profile-img-container { width: 280px; height: 280px; transform: rotate(0); margin-bottom: 20px; }
            
            .bento-grid { grid-template-columns: 1fr; }
            
            .nav-links { 
                display: none; flex-direction: column; position: fixed; 
                top: 80px; left: 5%; width: 90%; background: var(--surface); 
                padding: 24px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1);
            }
            .nav-links.active { display: flex; }
            .menu-btn { display: block; }
            footer h2 { font-size: 2.5rem; }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav>
        <div class="nav-container">
            <div class="logo">Alvino Nur Ardiana.</div>
            <div class="nav-links" id="navLinks">
                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#work">Projects</a>
                <a href="#contact">Contact</a>
            </div>
            <button class="menu-btn" id="menuBtn">☰</button>
        </div>
    </nav>

    <!-- HERO SECTION (TAMPILAN DEPAN) -->
    <section class="hero container" id="home">
        <div class="hero-content">
            <!-- Teks Hero -->
            <div class="hero-text">
                <div class="badge">🔥 Available for Work</div>
                <h1>Hi, I'm Alvino Nur Ardiana <br><span>Creative Developer</span></h1>
